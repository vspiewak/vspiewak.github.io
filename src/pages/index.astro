---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

import portrait from '~/assets/images/default.png';

const metadata = {
  title: 'Vincent Spiewak | Architect & Tech Lead',
  ignoreTitleTemplate: true,
};

const tagline = `
  <img src="${portrait.src}" alt="Vincent Spiewak" loading="eager"
       class="mx-auto mb-1 h-32 w-32 rounded-2xl object-cover shadow-lg" />
`;
---

<Layout metadata={metadata}>
  <Hero
    tagline={tagline}
    actions={[
      {
        variant: 'primary',
        text: 'LinkedIn',
        href: 'https://www.linkedin.com/in/vspiewak/',
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
      { text: 'GitHub', href: 'https://github.com/vspiewak', target: '_blank', icon: 'tabler:brand-github' },
    ]}
  >
    <Fragment slot="title"> Architect &amp; Tech Lead </Fragment>
    <Fragment slot="subtitle">
      I build platforms that teams run without me. <br class="hidden md:inline" />
      Automation everywhere. Humans always in the loop.
    </Fragment>
  </Hero>

  <BlogLatestPosts title="Latest posts" classes={{ container: 'pt-0 md:pt-0 lg:pt-0' }} />
</Layout>
